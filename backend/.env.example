# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=firmware_custom
PGUSER=postgres
PGPASSWORD=your_password

# Server
PORT=5000
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
LOGIN_LOCK_MINUTES=5            

SEMANTIC_ENABLED=1
SEMANTIC_AUTO_CLAIM=0
SEMANTIC_MARGIN=0.15          # decision floor for semantic auto-claim (decider.js default)
SEMANTIC_ASSIST_MIN_SCORE=0.60 # absolute top-candidate score floor for the assist suggestion rule (margin does not gate assist)
SEMANTIC_TOP_K=3              # candidate KB rows surfaced to the assist rule
SEMANTIC_TIMEOUT_MS=10000     # assist path timeout (embed + match)
SEMANTIC_MAX_ROWS=100000      # matrix size cap; pipeline refuses to build above this
EMBED_MODEL=Xenova/bge-small-en-v1.5
EMBED_TIMEOUT_MS=30000        
TELEMETRY_MIN_DECISIONS=20
TELEMETRY_MAX_WRONG_RATE=0.05

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Firmware Custom <no-reply@example.com>"
APP_LOGIN_URL=http://localhost:5173/login
ALLOWED_EMAIL_DOMAINS=example.com

# Password reset links
APP_RESET_URL=http://localhost:5173/reset-password
RESET_TOKEN_TTL_MINUTES=30