# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=firmware_custom
PGUSER=postgres
PGPASSWORD=your_password

# Server
PORT=5000
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# Semantic classification (optional) — see reports/lexical-semantic-state.md for posture
# SEMANTIC_ENABLED is the deployment kill switch: set to 0 to disable the whole pipeline
# without code changes; any other value (or omitting the key) leaves it enabled (code default).
SEMANTIC_ENABLED=1
SEMANTIC_MARGIN=0.15          # decision floor for semantic auto-claim (decider.js default)
SEMANTIC_ASSIST_MARGIN=0.15   # margin for the assist suggestion rule
SEMANTIC_TOP_K=3              # candidate KB rows surfaced to the assist rule
SEMANTIC_TIMEOUT_MS=10000     # assist path timeout (embed + match)
SEMANTIC_MAX_ROWS=100000      # matrix size cap; pipeline refuses to build above this
EMBED_MODEL=Xenova/bge-small-en-v1.5
EMBED_TIMEOUT_MS=30000        # embedder worker timeout
# Telemetry scorer (scripts/score-semantic-telemetry.js): exits 1 when wrong-rate is exceeded
TELEMETRY_MIN_DECISIONS=20
TELEMETRY_MAX_WRONG_RATE=0.05